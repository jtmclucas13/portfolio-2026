---
interface Props {
  withBorder?: boolean | undefined;
}

import Chameleon from "../assets/chameleon-2.svg";
import Flex from "./Flex.astro";
import Icon from "./Icon.astro";

const currentPath = Astro.url.pathname;
const { withBorder } = Astro.props;
---

<header class:list={[{ "with-border": withBorder }]}>
  <div>
    <Flex align="center" class="main-header" gap={1}>
      <Chameleon />
      <div>
        <a href="/"><h1>Joshua McLucas</h1></a>
        <h2 data-carousel class:list={[{ animate: currentPath === "/" }]}>
          Career Chameleon
        </h2>
      </div>
    </Flex>
    <div aria-label="Open Navigation" class="hamburger">menu</div>
    <div aria-hidden="true" class="navigation">
      <ul>
        <li><Icon name="home" /><a href="/">Home</a></li>
        <li>
          <Icon name="computer" /><a href="/software">Software</a>
        </li>
        <li>
          <Icon name="theater_comedy" /><a href="/theater">Theater</a>
        </li>
        <li>
          <Icon name="edit_note" /><a href="/writing">Writing</a>
        </li>
        <li>
          <Icon name="play_circle" /><a href="/streaming">Streaming</a>
        </li>
        <li><Icon name="drafts" /><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  const carousel = document.querySelector("[data-carousel]");
  const titles = [
    "Career Chameleon",
    "Software Engineer",
    "Theater Artist",
    "Live Streamer",
    "Writer",
    "Renaissance Man",
    "Artist",
    "Student",
    "Problem-Solver",
  ];
  let index = 0;

  function updateCarousel() {
    if (!carousel) return;

    carousel.textContent = titles[index] || "";
    index = (index + 1) % titles.length;
  }

  updateCarousel();

  if (window.location.pathname === "/") {
    setInterval(updateCarousel, 3000);
  }

  function isNavigationOpen() {
    const navigation = document.querySelector(".navigation");
    return navigation && navigation.classList.contains("open");
  }

  function openNavigation() {
    const navigation = document.querySelector(".navigation");
    navigation?.classList.add("open");
    navigation?.removeAttribute("aria-hidden");
  }

  function closeNavigation() {
    const navigation = document.querySelector(".navigation");
    navigation?.classList.remove("open");
    navigation?.setAttribute("aria-hidden", "true");
  }

  function handleClickOutsideNavigation(e: MouseEvent) {
    const navigation = document.querySelector(".navigation");
    if (!navigation || !isNavigationOpen()) {
      return;
    }

    if (!navigation.contains(e.target as Node)) {
      closeNavigation();
      document.removeEventListener("click", handleClickOutsideNavigation);
    }
  }

  const hamburger = document.querySelector(".hamburger");
  hamburger?.addEventListener("click", (e) => {
    // required to avoid immediate trigger of handleClickOutsideNavigation
    if (!isNavigationOpen()) {
      e.stopPropagation();
    }

    openNavigation();

    document.addEventListener("click", handleClickOutsideNavigation);
  });
</script>

<style>
  header {
    &.with-border {
      border-image-outset: 34px;
      border-bottom: 20px solid transparent;
      border-image: url("../assets/lace-border.png") 34 round;

      :global(.dark) & {
        border-image: url("../assets/lace-border-ivory.png") 34 round;
      }

      .content {
        margin-top: -20px;
      }
    }

    > div {
      align-items: center;
      background-color: var(--color-black);
      color: var(--color-secondary);
      display: flex;
      justify-content: space-between;
      padding: 1rem;

      @media screen and (min-width: 850px) {
        padding: 1rem 2rem;
      }
    }
  }

  h1 {
    color: var(--color-secondary);
    margin-bottom: 0.5rem;

    @media screen and (max-width: 850px) {
      font-size: 1.5rem;
    }
  }

  h2 {
    color: var(--color-secondary);
    @media screen and (max-width: 850px) {
      font-size: 1.3rem;
    }
  }

  .hamburger {
    cursor: pointer;
    font-family: var(--font-icon);
    font-size: 35px;
    transition: color 0.2s ease-in-out;

    @media screen and (min-width: 850px) {
      font-size: 50px;
    }

    &:hover {
      color: color-mix(in srgb, var(--color-secondary), #fff 30%);
    }
  }

  .main-header {
    svg {
      width: 72px;

      @media screen and (max-width: 850px) {
        display: none;
      }
    }
  }

  .navigation {
    --header-height: 94px;
    background-clip: padding-box;
    background-color: var(--color-black);
    border-image-outset: 34px;
    border: 20px solid transparent;
    border-image: url("../assets/lace-border.png") 34 round;
    height: calc(100% - var(--header-height));
    position: fixed;
    right: -500px;
    top: var(--header-height);
    transition: transform 0.2s ease-in;
    width: 300px;
    z-index: 999;

    :global(.dark) & {
      border-image: url("../assets/lace-border-ivory.png") 34 round;
    }

    @media screen and (min-width: 850px) {
      --header-height: 107px;
    }

    ul {
      padding: 2rem;

      li {
        align-items: center;
        display: flex;
        font-size: 1.5rem;
        gap: 8px;

        @media screen and (min-width: 850px) {
          font-size: 2rem;
        }
      }

      li:not(:last-child) {
        margin-bottom: 2.5rem;
      }

      a {
        &:hover {
          text-decoration: underline;
        }
      }
    }

    &.open {
      transform: translateX(-500px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    h2 {
      &.animate {
        animation: fadeIn 1.5s alternate infinite;
      }
    }
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
</style>
