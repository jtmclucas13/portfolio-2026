---
import Icon from "./Icon.astro";

interface Props {
  class?: string;
  icon?: string;
  size?: "medium" | "small";
  theme?: "outlined" | "solid";
}

const {
  class: className,
  icon,
  size = "medium",
  theme = "solid",
} = Astro.props;
---

<div class:list={["badge-container", size, theme, className]}>
  {icon && <Icon class="icon" name={icon} />}
  <slot />
</div>

<style>
  .badge-container {
    align-items: center;
    border-radius: 50px;
    color: var(--color-white);
    display: inline-flex;
    gap: 8px;
    justify-content: center;
    text-transform: uppercase;
    width: max-content;

    :global(.dark) & {
      color: var(--color-black);
    }

    &.medium {
      font-size: 0.875rem;
      padding: 0.25rem 0.75rem;

      @media screen and (min-width: 850px) {
        font-size: 1rem;
        padding: 0.5rem 1rem;
      }
    }

    &.small {
      font-size: 0.875rem;
      padding: 0.25rem 0.75rem;
    }

    &.solid {
      background-color: var(--color-primary);
    }

    &.outlined {
      border: 2px solid var(--color-black);
      color: var(--color-black);
    }
  }

  .icon {
    fill: var(--color-white);
  }
</style>
