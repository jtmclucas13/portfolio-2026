---
import { getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";
import LinkButton from "../../components/LinkButton.astro";
import Icon from "../../components/Icon.astro";
import MdxLink from "../../components/mdx/MdxLink.astro";

export async function getStaticPaths() {
  const posts = await getCollection("writing");
  return posts
    .sort(
      (a, b) =>
        new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf(),
    )
    .map((post, index) => {
      const prevPost = posts[index - 1];
      const nextPost = posts[index + 1];

      return {
        params: { id: post.id },
        props: {
          nextSlug: nextPost?.id || null,
          post,
          prevSlug: prevPost?.id || null,
        },
      };
    });
}

const { nextSlug, post, prevSlug } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<Post
  category={post.data.category}
  date={post.data.date}
  timeToRead={remarkPluginFrontmatter.minutesRead}
  title={post.data.title}
>
  <Content
    components={{
      a: MdxLink,
    }}
  />
  <div class="button-group">
    {
      prevSlug && (
        <LinkButton href={`/writing/${prevSlug}`}>
          <Icon name="arrow_back" />
          Previous
        </LinkButton>
      )
    }
    {
      nextSlug && (
        <LinkButton href={`/writing/${nextSlug}`}>
          Next <Icon name="arrow_forward" />
        </LinkButton>
      )
    }
  </div>
</Post>

<style>
  .button-group {
    display: flex;
    gap: 4rem;
    justify-content: center;
  }
</style>
