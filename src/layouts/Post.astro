---
interface Props {
  category: "Tech" | "Theater";
  date: string;
  timeToRead: string;
  title: string;
}
import Badge from "../components/Badge.astro";
import Icon from "../components/Icon.astro";
import LinkButton from "../components/LinkButton.astro";
import Layout from "../layouts/Layout.astro";

const { category, date, timeToRead, title } = Astro.props;
---

<Layout maxWidth={1000} withHeaderBorder>
  <div class="header">
    <LinkButton href="/writing"><Icon name="arrow_back" />All Posts</LinkButton>
    <div class="metadata">
      <div>
        <h1>{title}</h1>
        <h2>
          {
            `${new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}`
          }
        </h2>
        <p class="time-to-read">{timeToRead}</p>
      </div>
      <Badge icon={category === "Tech" ? "computer" : "theater_comedy"}>
        {category}
      </Badge>
    </div>

    <hr />
  </div>
  <div class="content">
    <slot />
  </div>
</Layout>

<style>
  .content {
    ul {
      li {
        font-size: 1.25rem;
        list-style-type: disc;
        margin-inline-start: 2rem;
        padding-bottom: 1rem;
      }
    }

    h2 {
      margin: 2rem 0 1rem;
    }

    p {
      margin-bottom: 2rem;
    }

    hr {
      margin-bottom: 2rem;
    }
  }

  .header {
    margin-bottom: 1.5rem;

    a {
      margin-bottom: 2rem;
    }
  }

  .metadata {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: space-between;

    @media screen and (min-width: 850px) {
      flex-direction: row;
      gap: 0;
    }
  }

  .time-to-read {
    font-style: italic;
  }
</style>
